{
    "common_params":
    {
        "gpu-idx": 0,
        "dataset": "cifar100",
        "dataset-root": "/data/cossu/imagenet/imagenet",
        "tr-mb-size": 10,
        "repl-mb-size": 10,
        "eval-mb-size": 256,
        "epochs": 1,
        "save-folder": "./logs",
        "probing-separate": false,
        "probing-torch": true,
        "probing-rr": false,
        "probing-all-exp": true,
        "mb-passes": 1,
        "max-process": 1
    },
    "experiments":
    [
        {
            "multiple_runs": {
                "seeds": [1,2]
            },
            "model": "simsiam",
            "strategy" : "replay",
            "mb-passes": 1,
            "online-transforms": true,
            "mem-size": 200,
            "buffer-type": "loss_aware",
            "insertion-policy": "loss",
            "extraction-policy": "loss",
            "gamma-extraction": 0.5,
            "analyze-features-deviation": true,
            "when-features-deviation": "10_end",
            "overlap-thresh-multipliers-euc": [1, 2, 3, 5],
            "overlap-thresh-multipliers-cosine": [0.1, 0.3, 1]

        }
        
    ]
}